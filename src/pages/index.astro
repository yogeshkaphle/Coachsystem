      <a href={WA_URL} target="_blank" rel="noopener noreferrer" class="cta-btn">
        {CTA_TEXT}
      </a>
    </div>

    <script>
      (function () {
        const sticky = document.getElementById('sticky-cta');
        const heroCta = document.querySelector('#hero .cta-btn') as HTMLElement | null;
        const footerCard = document.querySelector('.footer-card') as HTMLElement | null;

        if (!sticky || !heroCta || !footerCard) return;

        function update() {
          if (window.innerWidth >= 761) {
            (sticky as HTMLElement).style.display = 'none';
            sticky!.setAttribute('aria-hidden', 'true');
            return;
          }
          const heroRect = heroCta!.getBoundingClientRect();
          const footerRect = footerCard!.getBoundingClientRect();
          const heroVisible = heroRect.bottom > 0 && heroRect.top < window.innerHeight;
          const footerVisible = footerRect.top < window.innerHeight && footerRect.bottom > 0;
          const show = !heroVisible && !footerVisible;
          (sticky as HTMLElement).style.display = show ? 'block' : 'none';
          sticky!.setAttribute('aria-hidden', show ? 'false' : 'true');
        }

        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update, { passive: true });
        update();
      })();
    </script>
